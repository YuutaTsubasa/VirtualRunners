{
  "name": "virtual-runners",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build crates/runner-wasm --target web --release --out-dir ../../src/lib/local/pkg --no-pack",
    "predev": "npm run build:wasm",
    "prebuild": "npm run build:wasm",
    "test": "node --test tests/*.test.js && cargo test --manifest-path crates/runner-core/Cargo.toml --release",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "server": "cargo run --manifest-path src-tauri/Cargo.toml --bin runner-server --"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.0",
    "virtual-core": "github:YuutaTsubasa/VirtualCore#v0.5.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "~2.11.0",
    "svelte": "^5",
    "vite": "^6",
    "wasm-pack": "^0.13.1"
  }
}
